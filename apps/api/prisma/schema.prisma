// Prisma schema for the NSBE website.
//
// Models are added by the engineer who owns them (see docs/engineers/*.md).
// The first model and migration, `User`, is Elmer's hand-written task.
//
// Conventions:
//   - Models: PascalCase singular, mapped to snake_case plural tables with @@map("...")
//   - Fields: camelCase, mapped to snake_case columns with @map("...")
//   - Run migrations only against your own Neon dev branch:
//       pnpm --filter api prisma migrate dev --name <change>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  USER
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  name               String
  passwordHash       String   @map("password_hash")
  role               Role     @default(USER)
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  uploadedMedia Media[]

  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum MediaType {
  IMAGE
  VIDEO
}

model Media {
  id           Int       @id @default(autoincrement())
  s3Key        String    @unique @map("s3_key")
  type         MediaType
  mime         String
  width        Int?
  height       Int?
  alt          String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  uploadedById Int?      @map("uploaded_by")

  uploadedBy        User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  leadershipMembers LeadershipMember[]

  @@map("media")
}

model LeadershipMember {
  id        Int      @id @default(autoincrement())
  name      String
  bio       String?
  position  String?
  year      Int?
  major     String?
  linkedin  String?
  sortOrder Int      @default(0) @map("sort_order")
  term      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  photoMediaId Int?   @map("photo_media_id")
  photoMedia   Media? @relation(fields: [photoMediaId], references: [id], onDelete: SetNull)

  @@index([photoMediaId])
  @@map("leadership_members")
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(3)
  location    String
  rsvpLink    String?   @map("rsvp_link")
  // TODO: imageMediaId once Yahya's Media model lands

  @@index([startsAt])
  @@map("events")
}

// Site-wide values shown in the public footer. A singleton: there is only ever one row, id 1
// (a CHECK constraint in the migration enforces it). Every field is optional; a blank one is
// simply left out of the footer.
model SiteSettings {
  id           Int      @id @default(1)
  contactEmail String?  @map("contact_email")
  joinUrl      String?  @map("join_url")
  instagramUrl String?  @map("instagram_url")
  linkedinUrl  String?  @map("linkedin_url")
  tiktokUrl    String?  @map("tiktok_url")
  facebookUrl  String?  @map("facebook_url")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
