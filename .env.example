# Copy to .env and fill in. Never commit .env.
# Elmer shares the real values privately. Each engineer uses their OWN Neon branch.

# ---- API ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Neon: pooled connection (app runtime) and direct connection (Prisma migrations)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Auth (Elmer) — any long random string in dev
JWT_SECRET=

# Media storage, Cloudflare R2 (Yahya) — dev bucket only
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=nsbe-media-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=

# CORS (Abduraheem)
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# ---- Frontends (exposed to the browser — no secrets here) ----
# Leave empty in dev: Vite proxies /api to the local API. Set to https://api.<domain> in production.
VITE_API_URL=
VITE_MEDIA_PUBLIC_URL=
